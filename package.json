{
  "name": "turbo-rush",
  "version": "1.0.0",
  "private": true,
  "description": "Turbo Rush arcade kart racing game",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "desktop:dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "com.turborush.game",
    "productName": "Turbo Rush",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop.cjs", "package.json"],
    "win": { "target": ["nsis"], "icon": "icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}